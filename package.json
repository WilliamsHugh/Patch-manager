{
  "name": "patch-management-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@patch-management/web",
    "dev:api": "npm run start:dev --workspace=@patch-management/api",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "build:web": "npm run build --workspace=@patch-management/web",
    "build:api": "npm run build --workspace=@patch-management/api",
    "build:shared": "npm run build --workspace=@patch-management/shared",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace=@patch-management/api",
    "db:migrate": "npm run prisma:migrate --workspace=@patch-management/api",
    "db:seed": "npm run prisma:seed --workspace=@patch-management/api"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
